# RSF - SysEntrega — copie para .env e ajuste os valores

# --- Banco de dados ---
POSTGRES_DB=sysentrega
POSTGRES_USER=sysentrega
POSTGRES_PASSWORD=troque-esta-senha
# Em deploy separado, aponte para o servidor de dados:
# DATABASE_URL=postgresql://sysentrega:troque-esta-senha@IP_DO_BANCO:5432/sysentrega?schema=public
DATABASE_URL=postgresql://sysentrega:troque-esta-senha@postgres:5432/sysentrega?schema=public

# --- API ---
# Obrigatório, com ao menos 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRA_EM=10h
# Endereço público do sistema: vai nos links enviados ao cliente e no rodapé dos termos
APP_URL=https://sysentrega.rsfsys.com.br
# Quantos proxies existem na frente da API (o nginx do frontend conta 1; com
# Cloudflare ou outro proxy reverso na frente, 2). É o que faz o IP gravado na
# auditoria e nas assinaturas ser o de quem agiu de verdade.
PROXIES_CONFIAVEIS=1
FUSO_HORARIO=America/Sao_Paulo
HTTP_PORT=80

# --- Primeiro acesso ---
SEED_ADMIN_EMAIL=admin@sysentrega.local
# Senha do administrador inicial (e dos usuários de demonstração). Troque após o primeiro login.
SEED_SENHA_PADRAO=
# 1 = cria organizações, um usuário por perfil, um empreendimento e unidades de exemplo
SEED_DEMO=

# --- Agendamento ---
# Mínimo de horários que precisam ser oferecidos em cada proposta
AGENDAMENTO_MIN_OPCOES=1

# --- Assinatura ---
# interno    = o próprio SysEntrega colhe as assinaturas
# rsf-signer = os termos são enviados ao rsf-signer (ver docs/integracao-rsf-signer.md)
ASSINATURA_PROVEDOR=interno
RSF_SIGNER_URL=
RSF_SIGNER_API_KEY=
# Segredo do HMAC dos webhooks. Gere com: openssl rand -hex 32
RSF_SIGNER_WEBHOOK_SECRET=

# --- Código de uso único do cliente (assinatura interna) ---
CODIGO_MINUTOS=15
CODIGO_TENTATIVAS=5
# E-mail (SMTP) para enviar o código e o link de assinatura ao cliente.
# Sem SMTP o sistema RECUSA o envio do código em vez de fingir que mandou.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 1 = a cada mudança de situação da unidade, avisa por e-mail os usuários do
# perfil que precisa agir (a construtora só recebe das obras dela)
NOTIFICAR_POR_EMAIL=
# Só para ensaio, antes de o e-mail estar liberado: 1 escreve o código no log
# do servidor. Assinatura colhida assim NÃO tem valor, e isso fica registrado
# no termo e na auditoria. Nunca use em produção.
CODIGO_NO_LOG=
